<?xml version="1.0" encoding="utf-8"?>
<!-- Resources for the native home-screen widget system. Kept in a separate
     file so the pre-existing values files stay untouched. -->
<resources>

    <!-- ===== Widget palette: light mode (values-night holds dark). Widgets follow the phone's theme. ===== -->
    <color name="wg_bg">#FFFFFFFF</color>
    <color name="wg_card">#FFFFFFFF</color>
    <color name="wg_inner">#FFF2F2F7</color>
    <color name="wg_card_inner">#FFF2F2F7</color>
    <color name="wg_track">#FFE6E6EB</color>
    <color name="wg_ink">#FF111114</color>
    <color name="wg_dim">#FF55555C</color>
    <color name="wg_line">#14111114</color>
    <color name="wg_on_fill">#FFFFFFFF</color>
    <color name="wg_acc">#FFD98500</color>
    <color name="wg_acc_ink">#FFFFFFFF</color>
    <color name="wg_red">#FFD94B3E</color>
    <color name="wg_green">#FF2F9E4F</color>
    <color name="wg_blue">#FF2F6FE0</color>
    <color name="wg_purple">#FF7B4FD6</color>
    <color name="wg_purple_soft">#227B4FD6</color>
    <color name="wg_teal">#FF1E9C8C</color>
    <color name="wg_orange">#FFD9661F</color>

    <!-- ===== Widget strings ===== -->
    <string name="wg_tasks_label">Tasks</string>
    <string name="wg_tasks_desc">Today\'s and overdue tasks — scroll, one-tap complete, tap to open the exact task.</string>
    <string name="wg_habits_label">Habits</string>
    <string name="wg_habits_desc">Today\'s habits with progress — quick check-in, tap to open the exact habit.</string>
    <string name="wg_money_label">Money</string>
    <string name="wg_money_desc">Today\'s spend and your selected account balance, with quick add.</string>
    <string name="wg_mood_label">Mood</string>
    <string name="wg_mood_desc">One-tap mood logging with an optional note — no app launch needed.</string>
    <string name="wg_workout_label">Workout</string>
    <string name="wg_workout_desc">Your exercises with personal bests — tap to open the exact workout.</string>
    <string name="wg_ai_label">Ask AI</string>
    <string name="wg_ai_desc">Speak or type — log, update, or ask anything using your in-app AI.</string>
    <string name="wg_loghub_label">Momentum — Quick Log</string>
    <string name="wg_loghub_desc">One tap to log a habit, task, mood, sleep or journal — plus an AI button.</string>

    <!-- ===== Native popup theme (dialog-style activity used by widgets) ===== -->
    <style name="WidgetPopupTheme" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorAccent">@color/wg_acc</item>
        <item name="android:textColorPrimary">@color/wg_ink</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>

    <!-- v3 identity accents: one color per widget so each is recognizable at a glance -->
    <color name="wg_c_task">#5B9DFF</color>
    <color name="wg_c_habit">#7ED957</color>
    <color name="wg_c_money">#4FD8C4</color>
    <color name="wg_c_mood">#C08BFF</color>
    <color name="wg_c_sleep">#7B8CFF</color>
</resources>
