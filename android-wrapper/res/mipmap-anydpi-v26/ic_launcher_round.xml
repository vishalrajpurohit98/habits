<?xml version="1.0" encoding="utf-8"?>
<!-- Material adaptive icon. To switch option, change background+foreground:
     A (default): ic_bg_dark  + ic_fg_spark      B: ic_bg_amber + ic_fg_spark_ink
     C:           ic_bg_dark  + ic_fg_a          D: ic_bg_dark  + ic_fg_check
     (monochrome drives Android 13+ Material You theming; keep it the same glyph) -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_bg_dark"/>
    <foreground android:drawable="@drawable/ic_fg_spark"/>
    <monochrome android:drawable="@drawable/ic_mono_spark"/>
</adaptive-icon>
