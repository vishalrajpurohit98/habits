<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0D1218">
    <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Personal Tracker" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/widgetMomentum" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#28A9FF" android:textSize="30sp" android:textStyle="bold" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/widgetNext" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open the app to plan today" android:textColor="#AAB4C0" android:textSize="11sp" android:layout_marginTop="2dp" android:maxLines="2" />
</LinearLayout>
