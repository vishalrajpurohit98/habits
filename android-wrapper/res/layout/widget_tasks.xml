<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#16181C">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        <ImageButton android:id="@+id/w_mic" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@android:color/transparent" android:contentDescription="AI voice" android:src="@android:drawable/ic_btn_speak_now"/>
    </LinearLayout>
    <TextView android:id="@+id/w_main" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="4"/>
    <TextView android:id="@+id/w_secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#B8BDC7" android:textSize="11sp" android:maxLines="3"/>
    <LinearLayout android:id="@+id/w_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:orientation="horizontal">
        <Button android:id="@+id/w_action1" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="+ Add" android:textSize="11sp" android:textAllCaps="false"/>
        <Button android:id="@+id/w_action2" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_marginStart="6dp" android:text="Open" android:textSize="11sp" android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
