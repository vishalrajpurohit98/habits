<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingLeft="15dp" android:paddingRight="15dp" android:paddingTop="12dp" android:paddingBottom="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_money" android:tint="@color/wg_acc" android:contentDescription="@null"/>
<FrameLayout android:layout_width="7dp" android:layout_height="1dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13.5sp" android:textStyle="bold" android:textFontWeight="800" android:textColor="@color/wg_teal" android:text="Money" android:includeFontPadding="false"/>
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<TextView android:id="@+id/add_btn" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/wg_on_fill" android:background="@drawable/btn_plus_money" android:text="＋" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:id="@+id/money_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="top" android:paddingTop="9dp">
<TextView android:id="@+id/exp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="32sp" android:textStyle="bold" android:textFontWeight="800" android:textColor="@color/wg_red" android:text="₹0" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/wg_dim" android:text="TODAY’S EXPENSES" android:letterSpacing="0.12" android:paddingTop="3dp" android:includeFontPadding="false"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="11dp" android:layout_marginBottom="11dp" android:background="@color/wg_line"/>
<TextView android:id="@+id/bal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="25sp" android:textStyle="bold" android:textFontWeight="800" android:textColor="@color/wg_ink" android:text="—" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
<TextView android:id="@+id/acct_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/wg_dim" android:letterSpacing="0.12" android:paddingTop="3dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:id="@+id/acct_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="30dp" android:paddingTop="4dp">
<TextView android:id="@+id/acct_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/wg_ink" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
<FrameLayout android:layout_width="5dp" android:layout_height="1dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/wg_teal" android:text="▼" android:includeFontPadding="false"/>
</LinearLayout>
</LinearLayout>
</FrameLayout>
